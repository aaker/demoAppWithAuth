# Environment configuration for mock-vendor-server.service
# Edit these values, then restart the service:  sudo systemctl restart mock-vendor-server
#
# Installed to /etc/mock-vendor-server.env by install.sh

# Address/port the server listens on. Keep HOST on loopback so the port is only
# reachable via the Apache reverse proxy, not directly from the internet.
HOST=127.0.0.1
PORT=3001

# HMAC secret — must match the app's Callback Secret (horizon_extensions.remote_callback_secret)
WEBHOOK_SECRET=test-hmac-secret

# The token endpoint is taken from each webhook's validation_endpoint (no config needed).
# That endpoint is usually an internal loopback HTTPS URL with a self-signed cert, which is
# allowed by default. Set to false to require a valid TLS cert on the validation endpoint.
ALLOW_INSECURE_VALIDATION=true

# JWKS URL used to verify the cluster JWT
INSIGHT_JWKS_URL=https://insight-beta.netsapiens.com/.well-known/jwks.json

NODE_ENV=production
